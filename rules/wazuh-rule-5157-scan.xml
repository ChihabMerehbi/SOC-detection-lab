<group name="local,syslog,sshd,">

  <rule id="100010" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^5157$</field>
    <description>Windows Firewall blocked a connection - possible scan/probe detected</description>
    <group>firewall_block,recon,</group>
  </rule>

</group>
